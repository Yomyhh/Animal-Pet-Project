@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=DM+Sans:wght@300;400;500&display=swap');

    body {
        background: #f5f0e8 !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .login-page-wrapper {
        min-height: 100vh;
        background: #f5f0e8;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        font-family: 'DM Sans', sans-serif;
    }

    .login-card {
        display: flex;
        width: 100%;
        max-width: 900px;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(45, 74, 62, 0.15);
        background: #faf8f3;
    }

    .login-left {
        width: 40%;
        background: #2d4a3e;
        padding: 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .login-left::before {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
            bottom: -80px;
            left: -60px;
        }

        .login-left::after {
            content: '';
            position: absolute;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.06);
            top: 30px;
            right: -40px;
        }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        z-index: 1;
    }

    .brand-icon {
        width: 48px;
        height: 48px;
        background: #a8c5a0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .brand-name {
        font-family: 'Playfair Display', serif;
        color: #e8f0e4;
        font-size: 26px;
        font-weight: 600;
    }

    .paw-deco {
        position: absolute;
        opacity: 0.06;
        font-size: 100px;
        bottom: 80px;
        right: 10px;
        transform: rotate(-15deg);
    }

    .login-right {
        flex: 1;
        padding: 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-header {
        margin-bottom: 1.8rem;
    }

        .form-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            color: #1c2e24;
            margin-bottom: 6px;
        }

        .form-header p {
            color: #7a8e83;
            font-size: 13px;
        }

            .form-header p a {
                color: #2d4a3e;
                text-decoration: none;
                font-weight: 500;
            }

    .form-floating {
        margin-bottom: 1rem;
    }

        .form-floating > .form-control {
            height: 52px;
            border-radius: 10px;
            border: 1.5px solid #d8e4d4;
        }

            .form-floating > .form-control:focus {
                border-color: #2d4a3e;
                box-shadow: 0 0 0 3px rgba(45,74,62,.1);
            }

    .btn-login {
        width: 100%;
        height: 48px;
        background: #2d4a3e;
        color: white;
        border: none;
        border-radius: 10px;
        margin-top: .5rem;
        transition: .2s;
    }

        .btn-login:hover {
            background: #1e3329;
        }

    .remember-me {
        margin: 10px 0 15px;
        color: #4a5e54;
    }

    .login-links {
        margin-top: 1rem;
    }

        .login-links a {
            color: #2d4a3e;
            text-decoration: none;
            font-size: 13px;
        }

    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 1.4rem 0 1rem;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background: #e2ece0;
    }

    .divider-text {
        font-size: 11px;
        color: #a8b9b2;
    }

    .btn-external {
        height: 42px;
        padding: 0 16px;
        background: white;
        border: 1.5px solid #d8e4d4;
        border-radius: 9px;
        margin-right: 8px;
    }

    @@media (max-width:640px) {

        .login-left {
            display: none;
        }

        .login-right {
            padding: 2rem 1.5rem;
        }
    }
</style>

<div class="login-page-wrapper">

    <div class="login-card">

        <div class="login-left">
            <a class="brand" href="/">
                <div class="brand-icon">🐾</div>
                <span class="brand-name">PetAdoption</span>
            </a>

            <div class="paw-deco">🐾</div>
        </div>

        <div class="login-right">

            <div class="form-header">
                <h1>Welcome Back</h1>

                <p>
                    Don’t have an account?
                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        Create one
                    </a>
                </p>
            </div>

            @{
                if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <form id="external-account"
                          asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="btn-external"
                                    name="provider"
                                    value="@provider.Name">

                                @provider.DisplayName
                            </button>
                        }
                    </form>

                    <div class="divider">
                        <div class="divider-line"></div>
                        <span class="divider-text">OR LOGIN WITH EMAIL</span>
                        <div class="divider-line"></div>
                    </div>
                }
            }

            <form id="account" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="form-floating">
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           placeholder="name@example.com" />

                    <label asp-for="Input.Email">Email</label>

                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="password" />

                    <label asp-for="Input.Password">Password</label>

                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>

                <div class="remember-me">
                    <input asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe"></label>
                </div>

                <button id="login-submit"
                        type="submit"
                        class="btn-login">
                    Log in
                </button>

                <div class="login-links">
                    <p>
                        <a asp-page="./ForgotPassword">
                            Forgot your password?
                        </a>
                    </p>

                    <p>
                        <a asp-page="./ResendEmailConfirmation">
                            Resend email confirmation
                        </a>
                    </p>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}