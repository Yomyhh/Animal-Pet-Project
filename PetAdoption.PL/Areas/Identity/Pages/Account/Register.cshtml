@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=DM+Sans:wght@300;400;500&display=swap');

    body {
        margin: 0;
        padding: 0;
        background: #f5f0e8;
        font-family: 'DM Sans', sans-serif;
    }

    .register-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
    }

    .register-card {
        width: 100%;
        max-width: 950px;
        background: #faf8f3;
        border-radius: 22px;
        overflow: hidden;
        display: flex;
        box-shadow: 0 20px 60px rgba(0,0,0,.08);
    }

    /* LEFT */
    .register-left {
        width: 40%;
        background: #2d4a3e;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
    }

        .register-left::before {
            content: '';
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            bottom: -100px;
            left: -70px;
        }

        .register-left::after {
            content: '';
            position: absolute;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
            top: 20px;
            right: -40px;
        }

    .brand {
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
    }

    .brand-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        background: #a8c5a0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .brand-name {
        color: #fff;
        font-size: 30px;
        font-family: 'Playfair Display', serif;
    }

    /* RIGHT */
    .register-right {
        flex: 1;
        padding: 50px;
    }

        .register-right h1 {
            font-size: 32px;
            margin-bottom: 8px;
            color: #1c2e24;
            font-family: 'Playfair Display', serif;
        }

        .register-right p {
            color: #6f8579;
            margin-bottom: 25px;
        }

            .register-right p a {
                color: #2d4a3e;
                text-decoration: none;
                font-weight: 600;
            }

    .validation-summary-errors {
        background: #fff0f0;
        border: 1px solid #f1bcbc;
        color: #c14d4d;
        padding: 14px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #5b6d63;
            font-size: 14px;
        }

    .form-control {
        width: 100%;
        height: 56px;
        border-radius: 14px;
        border: 1.5px solid #d9e4d5;
        padding: 0 18px;
        font-size: 15px;
        background: white;
        transition: .2s;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #2d4a3e;
            box-shadow: 0 0 0 4px rgba(45,74,62,.08);
        }

    .field-validation-error {
        color: #c14d4d;
        font-size: 13px;
        margin-top: 6px;
        display: block;
    }

    .btn-register {
        width: 100%;
        height: 56px;
        border: none;
        border-radius: 14px;
        background: #2d4a3e;
        color: white;
        font-size: 17px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
        margin-top: 10px;
    }

        .btn-register:hover {
            background: #1f352b;
        }

    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background: #dce7d8;
    }

    .divider span {
        font-size: 12px;
        color: #94a59c;
    }

    .btn-external {
        height: 45px;
        padding: 0 18px;
        border-radius: 12px;
        border: 1px solid #d9e4d5;
        background: white;
        cursor: pointer;
        margin-right: 10px;
        transition: .2s;
    }

        .btn-external:hover {
            border-color: #2d4a3e;
            background: #f4f8f2;
        }

    @@media(max-width: 768px) {

        .register-left {
            display: none;
        }

        .register-right {
            padding: 35px 25px;
        }
    }
</style>

<div class="register-wrapper">

    <div class="register-card">

        <div class="register-left">

            <a href="/" class="brand">
                <div class="brand-icon">🐾</div>
                <div class="brand-name">PetAdoption</div>
            </a>

        </div>

        <div class="register-right">

            <h1>Create your account</h1>

            <p>
                Already have one?
                <a asp-page="./Login"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    Sign in here
                </a>
            </p>

            @{
                if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <form asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="btn-external"
                                    name="provider"
                                    value="@provider.Name">

                                @provider.DisplayName
                            </button>
                        }
                    </form>

                    <div class="divider">
                        <div class="divider-line"></div>
                        <span>OR REGISTER WITH EMAIL</span>
                        <div class="divider-line"></div>
                    </div>
                }
            }

            <form id="registerForm"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="form-group">

                    <label asp-for="Input.Email"></label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Input.Email"></span>

                </div>

                <div class="form-group">

                    <label asp-for="Input.Password"></label>

                    <input asp-for="Input.Password"
                           class="form-control"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Input.Password"></span>

                </div>

                <div class="form-group">

                    <label asp-for="Input.ConfirmPassword"></label>

                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           placeholder="Confirm your password" />

                    <span asp-validation-for="Input.ConfirmPassword"></span>

                </div>

                <button type="submit"
                        class="btn-register">

                    Create account

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}