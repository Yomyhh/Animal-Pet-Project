@using PetAdoption.BL.DTOs
@model IEnumerable<AdoptionRequestDTO>

<h2>Adoption Requests</h2>

<table class="table">
    <thead>
        <tr>
            <th>Pet</th>
            <th>User</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.PetName</td>
                <td>@r.UserEmail</td>
                <td>@r.Status</td>
                <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>

                <td>
                    <a asp-action="Approve" asp-route-id="@r.Id" class="btn btn-success btn-sm">Approve</a>
                    <a asp-action="Reject" asp-route-id="@r.Id" class="btn btn-danger btn-sm">Reject</a>
                </td>
            </tr>
        }
    </tbody>
</table>