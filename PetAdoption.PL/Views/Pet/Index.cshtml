@model IEnumerable<PetAdoption.BL.DTOs.PetDTO>

<h2>Available Pets</h2>
<a asp-action="Create" class="btn btn-success mb-3">Add New Pet</a>

<table class="table">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Type</th>
            <th>Age</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pet in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(pet.ImageBase64))
                    {
                        <img src="data:image/jpeg;base64,@pet.ImageBase64"
                             style="width:60px; height:60px; object-fit:cover; border-radius:8px;" />
                    }
                    else
                    {
                        <span>No Image</span>
                    }
                </td>
                <td>@pet.Name</td>
                <td>@pet.Type</td>
                <td>@pet.Age</td>
                <td>
                    <a asp-action="Details" asp-route-id="@pet.Id"
                       class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@pet.Id"
                       class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@pet.Id"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>