@model PetAdoption.BL.DTOs.CreatePetDTO

@{
    ViewData["Title"] = "Edit Pet";
}

<div class="container mt-5">

    <div class="card shadow p-4" style="border-radius:15px;">

        <h2 class="text-center mb-4">Edit Pet</h2>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="ImageBase64" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label"></label>
                <input asp-for="Type" class="form-control" />
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Age" class="form-label"></label>
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model?.ImageBase64))
            {
                <div class="mb-3">
                    <p class="fw-bold">Current Image:</p>
                    <img src="data:image/jpeg;base64,@Model.ImageBase64"
                         style="width:150px;height:150px;object-fit:cover;border-radius:10px;" />
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Change Image (Optional)</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>

        </form>

    </div>

</div>