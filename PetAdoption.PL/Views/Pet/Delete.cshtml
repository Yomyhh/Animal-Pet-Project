@model PetAdoption.BL.DTOs.PetDTO

@{
    ViewData["Title"] = "Delete Pet";
}

<div class="container mt-5">

    <div class="card shadow p-4" style="max-width:600px; border-radius:15px;">

        <h2 class="text-danger mb-4">Delete Pet</h2>

        <div class="alert alert-danger">
            Are you sure you want to delete this pet?
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageBase64))
        {
            <div class="text-center mb-4">
                <img src="data:image/jpeg;base64,@Model.ImageBase64"
                     style="width:180px;height:180px;object-fit:cover;border-radius:12px;" />
            </div>
        }

        <table class="table table-bordered">
            <tr>
                <th>Name</th>
                <td>@Model.Name</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>@Model.Type</td>
            </tr>
            <tr>
                <th>Age</th>
                <td>@Model.Age years</td>
            </tr>
        </table>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>

    </div>

</div>