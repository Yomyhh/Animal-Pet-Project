@model IEnumerable<PetAdoption.BL.DTOs.AdoptionRequestDTO>

<h2>Adoption Requests</h2>

<table class="table">

    <thead>
        <tr>
            <th>User</th>
            <th>Pet</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.UserEmail</td>

                <td>@item.PetName</td>

                <td>@item.Status</td>

                <td>@item.RequestDate</td>

                <td>

                    @if (item.Status == "Pending")
                    {
                        <a asp-action="Approve"
                           asp-route-id="@item.Id"
                           class="btn btn-success btn-sm">
                            Approve
                        </a>

                        <a asp-action="Reject"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Reject
                        </a>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>